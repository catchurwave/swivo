{
  "manifest_version": 3,
  "name": "Swivo Autofill — Guichet unique",
  "version": "0.1.0",
  "description": "Pré-remplit les formulaires du Guichet unique INPI / formalites.entreprises.gouv.fr à partir d'un dossier Swivo exporté.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://procedures.inpi.fr/*",
    "https://*.inpi.fr/*",
    "https://formalites.entreprises.gouv.fr/*",
    "https://procedure.inpi.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Swivo Autofill",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://procedures.inpi.fr/*",
        "https://procedure.inpi.fr/*",
        "https://*.inpi.fr/*",
        "https://formalites.entreprises.gouv.fr/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selectors.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
