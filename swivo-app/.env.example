# WordPress REST API base URL — used by the SPA to fetch content.
# In dev, /wp-json requests are proxied to this host (see vite.config.ts).
VITE_WP_API_URL=https://swivo.fr/wp

# Public SPA URL (canonical, OG, sitemap).
VITE_SITE_URL=https://swivo.fr

# Subpath where the SPA is served. "/" for domain root, "/sub/" for subfolder.
VITE_BASE=/
