# SPA history fallback + asset caching for Apache (swivo.fr root).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Skip WP backend — let /wp/* be handled by its own .htaccess.
  RewriteRule ^wp/ - [L]
  RewriteRule ^wp-json - [L]
  RewriteRule ^wp-admin - [L]
  RewriteRule ^wp-login - [L]

  # Serve existing files / directories directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pre-rendered route: <path>/index.html.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Fallback for any unmatched route — SPA picks it up client-side.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2?|ttf|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
